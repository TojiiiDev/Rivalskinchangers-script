            if sd then repData[dk][RC:ToEnum("Skin")] = sd end
            if wd then repData[dk][RC:ToEnum("Wrap")] = wd end
            if cd then repData[dk][RC:ToEnum("Charm")] = cd end
        end
        return origNew(repData, cliItm)
    end
end

-- Hook FireServer pour Empêcher le serveur de dire non
local remotes = ReplicatedStorage:FindFirstChild("Remotes")
local dataRem = remotes and remotes:FindFirstChild("Data")
local equipRem = dataRem and dataRem:FindFirstChild("EquipCosmetic")

if equipRem then
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        if getnamecallmethod() == "FireServer" and self == equipRem then
            local args = {...}
            local weapon, cosType, cosName = args[1], args[2], args[3]
            if weapon and cosType then
                if cosName and cosName ~= "None" and cosName ~= "" then
                    localEquipped[weapon] = localEquipped[weapon] or {}
                    localEquipped[weapon][cosType] = cosName
                else
                    if localEquipped[weapon] then localEquipped[weapon][cosType] = nil end
                end
                pcall(function() PlayerDataController.CurrentData:Replicate("WeaponInventory") end)
                -- Force le refresh du ViewModel actif pour que ça s'affiche en main !
                pcall(function()
                    local fCtrl = require(LocalPlayer.PlayerScripts.Controllers.FighterController)
                    local f = fCtrl:GetFighter(LocalPlayer)
                    if f then
                        for _, item in pairs(f.Items) do
                            if item.Name == weapon and item._CreateViewModel and item.ViewModel then
                                item:_CreateViewModel(item.ViewModel)
                            end
                        end
                    end
                end)
            end
            return -- On ne fait pas oldNamecall, le serveur ne reçoit rien !
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end

