local Modules = ReplicatedStorage:WaitForChild("Modules", 10)
local CosmeticLibrary = require(Modules:WaitForChild("CosmeticLibrary", 10))
local EnumLibrary = require(Modules:WaitForChild("EnumLibrary", 10))
local PlayerDataController = require(LocalPlayer.PlayerScripts.Controllers:WaitForChild("PlayerDataController", 10))

local cosTypes = {"Skin","Wrap","Charm","Dance","Emote"}
local function isCosType(c)
    if not c then return false end
    for _, t in ipairs(cosTypes) do if c.Type == t then return true end end
    return false
end

local localEquipped = {}

local function mkCosmetic(nm, ctype, opts)
    local base = CosmeticLibrary.Cosmetics[nm]
    if not base then return nil end
    local d = {}
    for k, v in pairs(base) do d[k] = v end
    d.Name = nm
    d.Type = d.Type or ctype
    d.Seed = d.Seed or math.random(1, 1000000)
    if EnumLibrary then
        local s, eid = pcall(EnumLibrary.ToEnum, EnumLibrary, nm)
        if s and eid then d.Enum = eid; d.ObjectID = d.ObjectID or eid end
    end
    if opts then
        if opts.inverted ~= nil then d.Inverted = opts.inverted end
        if opts.favoritesOnly ~= nil then d.OnlyUseFavorites = opts.favoritesOnly end
    end
    return d
end

-- Hook Unlock All & Equip (Version GitHub)
local origOwns = CosmeticLibrary.OwnsCosmetic
CosmeticLibrary.OwnsCosmetic = function(self, inv, nm, wep)
    if nm:find("MISSING_") or nm == "Bubble Gun" then return origOwns(self, inv, nm, wep) end
    local c = CosmeticLibrary.Cosmetics[nm]
    if c and isCosType(c) then return true end
    return origOwns(self, inv, nm, wep)
end

local origGet = PlayerDataController.Get
PlayerDataController.Get = function(self, key)
    local val = origGet(self, key)
    if key == "CosmeticInventory" then
        local prx = {}
        if val then
            for k, v in pairs(val) do
                local c = CosmeticLibrary.Cosmetics[k]
                if c and isCosType(c) then prx[k] = v end
            end
        end
        return setmetatable(prx, {__index = function(_, k)
            local c = CosmeticLibrary.Cosmetics[k]
            if c and isCosType(c) then return true end
            return nil
        end})
    end
    return val
end

local origGetWep = PlayerDataController.GetWeaponData
PlayerDataController.GetWeaponData = function(self, wn)
    local d = origGetWep(self, wn)
    if not d then return nil end
    local m = {}
    for k, v in pairs(d) do m[k] = v end
    m.Name = wn
    if localEquipped[wn] then
        local eq = localEquipped[wn]
        if eq.Skin then local sd = mkCosmetic(eq.Skin, "Skin"); if sd then m.Skin = sd; m.Name = sd.Name end end
        if eq.Wrap then local wd = mkCosmetic(eq.Wrap, "Wrap"); if wd then m.Wrap = wd end end
        if eq.Charm then local cd = mkCosmetic(eq.Charm, "Charm"); if cd then m.Charm = cd end end
    end
    return m
end

