            local wd = eq.Wrap and mkCosmetic(eq.Wrap, "Wrap")
            local cd = eq.Charm and mkCosmetic(eq.Charm, "Charm")
            if vmRef[dk] then
                if sd then vmRef[dk][self:ToEnum("Skin")] = sd; vmRef[dk][self:ToEnum("Name")] = sd.Name end
                if wd then vmRef[dk][self:ToEnum("Wrap")] = wd end
                if cd then vmRef[dk][self:ToEnum("Charm")] = cd end
            elseif vmRef.Data then
                if sd then vmRef.Data.Skin = sd; vmRef.Data.Name = sd.Name end
                if wd then vmRef.Data.Wrap = wd end
                if cd then vmRef.Data.Charm = cd end
            end
        end
        return origCVM(self, vmRef)
    end
end

