local guiVisible = true
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        guiVisible = not guiVisible
        pcall(function() if Library.ScreenGui then Library.ScreenGui.Enabled = guiVisible end end)
        pcall(function() if Library.Window and Library.Window.Enabled ~= nil then Library.Window.Enabled = guiVisible end end)
    end
end)

