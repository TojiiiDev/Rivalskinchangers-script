local function createToggle(labelText, key, y)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -44, 0, 36)
    row.Position = UDim2.fromOffset(22, y)
    row.BackgroundTransparency = 1
    row.Parent = window

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -65, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Config.Text
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.fromOffset(48, 25)
    toggle.Position = UDim2.new(1, -48, 0.5, -12)
    toggle.Text = ""
    toggle.AutoButtonColor = false
    toggle.BackgroundColor3 = Color3.fromRGB(65, 65, 78)
    toggle.Parent = row

    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(1, 0)
    toggleCorner.Parent = toggle

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(19, 19)
    knob.Position = UDim2.fromOffset(3, 3)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Parent = toggle

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local function refresh(animated)
        local enabled = Settings[key]

        local targetColor = enabled
            and Config.Accent
            or Color3.fromRGB(65, 65, 78)

        local targetPosition = enabled
            and UDim2.new(1, -22, 0, 3)
            or UDim2.fromOffset(3, 3)

        if animated then
            TweenService:Create(
                toggle,
                TweenInfo.new(0.15),
                {BackgroundColor3 = targetColor}
            ):Play()

            TweenService:Create(
                knob,
                TweenInfo.new(0.15),
                {Position = targetPosition}
            ):Play()
        else
            toggle.BackgroundColor3 = targetColor
            knob.Position = targetPosition
        end
    end

    toggle.Activated:Connect(function()
        Settings[key] = not Settings[key]
        refresh(true)
        notify(labelText .. (Settings[key] and " activé" or " désactivé"), true)
    end)

    refresh(false)
end

