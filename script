createToggle("Silent Load", "SilentLoad", 142)
createToggle("Notifications", "Notifications", 184)

-- ==========================================
-- START
-- ==========================================

local started = false
local busy = false

local startButton = Instance.new("TextButton")
startButton.Name = "StartButton"
startButton.Size = UDim2.fromOffset(150, 42)
startButton.Position = UDim2.new(0, 22, 1, -65)
startButton.BackgroundColor3 = Config.Accent
startButton.Text = Config.ButtonText
startButton.TextColor3 = Color3.new(1, 1, 1)
startButton.Font = Enum.Font.GothamBold
startButton.TextSize = 14
startButton.AutoButtonColor = false
startButton.Parent = window

local startCorner = Instance.new("UICorner")
startCorner.CornerRadius = UDim.new(0, 12)
startCorner.Parent = startButton

local footer = Instance.new("TextLabel")
footer.Size = UDim2.new(1, -200, 0, 20)
footer.Position = UDim2.new(0, 185, 1, -54)
footer.BackgroundTransparency = 1
footer.Text = Config.Footer
footer.TextColor3 = Color3.fromRGB(145, 140, 164)
footer.Font = Enum.Font.GothamMedium
footer.TextSize = 10
footer.TextXAlignment = Enum.TextXAlignment.Right
footer.Parent = window

local function runAction()
    local success, err = pcall(launchScript)

    if not Settings.SilentLoad then
        if success then
            notify("Script chargé avec succès", true)
        else
            warn("[CustomLauncher] " .. tostring(err))
            notify("Erreur pendant le lancement", false)
        end
    end

    return success
end

startButton.Activated:Connect(function()
    if busy then return end
    busy = true

    startButton.Text = "LOADING..."
    subtitle.Text = "Initialisation..."

    task.wait(0.2)

    local success = runAction()

    started = success
    busy = false

    if success then
        startButton.Visible = false
        subtitle.Text = "Chargé • RightShift : paramètres"
        if not Settings.SilentLoad then
            notify("Panneau prêt", true)
        end
    else
        startButton.Text = "RETRY"
        subtitle.Text = "Échec du lancement"
    end
end)

-- ==========================================
-- AUTO EXECUTE
-- ==========================================

if Settings.AutoExecute then
    task.spawn(function()
        task.wait(0.5)
        local success = runAction()
        started = success
        if success then
            startButton.Visible = false
            subtitle.Text = "Chargé • RightShift : paramètres"
        end
    end)
end

-- ==========================================
-- RIGHT SHIFT : AFFICHER / MASQUER
-- ==========================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode ~= Config.ToggleKey then return end

    if started then
        window.Visible = not window.Visible
    end
end)

